generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(BUYER)
  emailVerified Boolean   @default(false)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor        Vendor?
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  refreshTokens RefreshToken[]
}

enum UserRole {
  BUYER
  VENDOR
  ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Vendor {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  storeName   String
  slug        String       @unique
  description String?
  logoUrl     String?
  bannerUrl   String?
  bankDetails Json?
  ktpNumber   String?
  npwpNumber  String?
  status      VendorStatus @default(PENDING)
  commissionRate Decimal?  @default(10.0)
  rating        Float?      @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products    Product[]
  vendorOrders VendorOrder[]
  walletTrx   WalletTransaction[]
  payouts     PayoutRequest[]
  reviews     Review[]
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  products    Product[]
}

model Product {
  id          String     @id @default(cuid())
  vendorId    String
  vendor      Vendor     @relation(fields: [vendorId], references: [id])
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  name        String
  slug        String     @unique
  description String
  basePrice   Decimal    @db.Decimal(12, 2)
  status      ProductStatus @default(ACTIVE)
  isFeatured  Boolean    @default(false)
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  variants    ProductVariant[]
  reviews     Review[]
  wishlistItems WishlistItem[]
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  SOLD_OUT
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  sku        String  @unique
  attributes Json
  price       Decimal @db.Decimal(12, 2)
  stockQuantity Int  @default(0)
  weight      Decimal? @db.Decimal(8, 2)
  dimensions  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems    OrderItem[]
  cartItems     CartItem[]
  images        ProductImage[]
}

model ProductImage {
  id            String       @id @default(cuid())
  productVariantId String
  variant      ProductVariant @relation(fields: [productVariantId], references: [id])
  url          String
  alt          String?
  position     Int            @default(0)
  isPrimary    Boolean        @default(false)
  createdAt    DateTime       @default(now())
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String?
  name      String
  phone     String
  address    String
  province   String?
  city       String?
  district   String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productVariantId String
  variant    ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, productVariantId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id            String       @id @default(cuid())
  buyerId       String
  buyer         User         @relation(fields: [buyerId], references: [id])
  orderNumber   String       @unique
  totalAmount   Decimal      @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING)
  shippingStatus ShippingStatus @default(PENDING)
  shippingAddress Json
  shippingFee   Decimal      @db.Decimal(10, 2) @default(0)
  taxAmount     Decimal      @db.Decimal(10, 2) @default(0)
  discountAmount Decimal     @db.Decimal(10, 2) @default(0)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  vendorOrders  VendorOrder[]
  payments      Payment[]
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShippingStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model VendorOrder {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  subtotal      Decimal  @db.Decimal(14, 2)
  shippingFee   Decimal  @db.Decimal(10, 2)
  taxAmount     Decimal  @db.Decimal(10, 2)
  commissionFee  Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(14, 2)
  status        VendorOrderStatus @default(PENDING)
  trackingNumber String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems    OrderItem[]
  payoutItems   PayoutItem[]
}

enum VendorOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model OrderItem {
  id            String   @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id])
  productVariantId String
  variant       ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  gatewayRef    String?
  amount        Decimal  @db.Decimal(14, 2)
  method        String
  status        PaymentStatus @default(PENDING)
  payload       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WalletTransaction {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  type          WalletTransactionType
  amount        Decimal  @db.Decimal(14, 2)
  description   String?
  referenceId   String?
  status        WalletTransactionStatus @default(COMPLETED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  COMMISSION
  HOLD
  RELEASE
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model PayoutRequest {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  amount        Decimal  @db.Decimal(14, 2)
  bankDetails   Json
  status        PayoutStatus @default(PENDING)
  processedAt   DateTime?
  processedBy   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payoutItems   PayoutItem[]
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model PayoutItem {
  id            String   @id @default(cuid())
  payoutRequestId String
  payoutRequest PayoutRequest @relation(fields: [payoutRequestId], references: [id])
  vendorOrderId String?
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id])
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  rating      Int      @default(0)
  title       String?
  comment     String?
  isVerifiedPurchase Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images      ReviewImage[]
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id])
  url       String
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
